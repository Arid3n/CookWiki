{
  "expo": {
    "name": "CookWiki",
    "slug": "cookwiki_app",
    "scheme": "cookwiki",
    "version": "4.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arid3n.cookwiki",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.arid3n.cookwiki_app",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "CookWiki uses the camera to scan nutrition labels. Photos are not saved."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0026645c-5630-4c8b-841d-d31816a8c6d5"
      }
    }
  }
}